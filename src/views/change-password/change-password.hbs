<main class="change-password">
    {{{ AvatarEditor }}}
    <form class="change-password__fields">
        {{#each config}}
            {{{ ProfileFormField
                    id=id
                    label=label
                    type=type
                    ref=id
                    edit=../edit
            }}}
        {{/each}}
        <div class="change-password__submit">
            {{{ Button text="Сохранить" type="submit" }}}
        </div>
    </form>
</main>
