<li
    class="chat-item{{#if selected}} chat-item--selected{{/if}}"
    data-chat-id="{{id}}"
>
    <div
        class="chat-item__avatar"
        {{#if avatar}}style="background-image: url('{{avatar}}'); background-size: cover;"{{/if}}
    ></div>
    <div class="chat-item__body">
        <h4 class="chat-item__name">{{title}}</h4>
        <span class="chat-item__message">{{message}}</span>
    </div>
    <div class="chat-item__meta">
        <span class="chat-item__time">{{time}}</span>
        {{#if unreadCount}}
        <span class="chat-item__unread">{{unreadCount}}</span>
        {{/if}}
    </div>
</li>
